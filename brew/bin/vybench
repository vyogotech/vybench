#!/bin/bash
# vybench — macOS CLI wrapper for Frappe bench.
#
# Usage:
#   vybench bench <bench-command>       run a bench command
#   vybench set mode=developer          set configuration
#   vybench get mode                    get configuration
#   vybench start                       start all services via brew
#   vybench stop                        stop all services via brew
#   vybench restart                     restart all services via brew
#   vybench status                      show service status
#   vybench logs [service]              tail service logs
#   vybench mysql                       open MariaDB client
#   vybench redis-cli                   open Redis client
#   vybench help                        show this help
set -e

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
LIBEXEC_DIR="$(cd "$SCRIPT_DIR/../libexec" 2>/dev/null && pwd)"
if [ ! -f "$LIBEXEC_DIR/vybench-common.sh" ]; then
  if [ -f "/opt/homebrew/opt/vybench/libexec/vybench-common.sh" ]; then
    LIBEXEC_DIR="/opt/homebrew/opt/vybench/libexec"
  elif [ -f "/opt/homebrew/opt/vybench-local/libexec/vybench-common.sh" ]; then
    LIBEXEC_DIR="/opt/homebrew/opt/vybench-local/libexec"
  elif [ -f "/usr/local/opt/vybench/libexec/vybench-common.sh" ]; then
    LIBEXEC_DIR="/usr/local/opt/vybench/libexec"
  fi
fi
. "$LIBEXEC_DIR/vybench-common.sh"

# ---------------------------------------------------------------------------
# help
# ---------------------------------------------------------------------------
show_help() {
  cat <<'EOF'

  ╦  ╦┬ ┬┌┐ ┌─┐┌┐┌┌─┐┬ ┬
  ╚╗╔╝└┬┘├┴┐├┤ ││││  ├─┤
   ╚╝  ┴ └─┘└─┘┘└┘└─┘┴ ┴

  Frappe Bench & ERPNext, packaged for macOS via Homebrew.

  Frappe® and ERPNext® are trademarks of Frappe Technologies Pvt. Ltd.
  This package is an independent distribution not affiliated with or
  endorsed by Frappe Technologies.

  ─────────────────────────────────────────────

  QUICK START

    vybench start                        # vybench, with its own MariaDB and Redis
    vybench bench new-site mysite.localhost --admin-password admin
    # → Open http://mysite.localhost:8000

  SERVICES

    vybench start                        start all services
    vybench stop                         stop all services
    vybench restart                      restart all services
    vybench status                       show service status
    vybench logs web                     tail web log
    vybench logs worker-default          tail worker log

  CONFIGURATION

    vybench set mode=developer           switch to dev mode
    vybench set mode=production          switch to prod mode
    vybench set bind=0.0.0.0            expose web on LAN
    vybench get mode                     view current mode

  INTERACTIVE TUI

    vybench tui                          launch interactive TUI

  DIAGNOSE AND REPAIR

    vybench doctor                       check the active bench and explain
                                         anything wrong with it
    vybench doctor --fix                 repair what can be repaired
    vybench doctor --all                 check every registered bench

  MULTI-BENCH MANAGEMENT

    vybench bench list                   list registered benches (* = active)
    vybench bench current                show the active bench
    vybench bench switch <name>          switch the active bench
    vybench bench new <name> [--db mariadb|postgres] [--version VER]
                                         create a bench (the packaged Frappe is
                                         linked instantly; other versions run
                                         bench init)
    vybench bench attach <name> <path>   register an existing bench
    vybench bench drop <name>            remove a bench from the registry
                                         (files are kept)

  BENCH COMMANDS

    vybench bench new-site mysite.localhost --admin-password admin
    vybench bench get-app hrms --branch version-16
    vybench bench --site mysite.localhost install-app hrms
    vybench bench --site mysite.localhost list-apps
    vybench bench --site mysite.localhost build

  CLIENT TOOLS

    vybench mysql                        MariaDB client
    vybench redis-cli                    Redis client

  DATA & PATHS

    Sites & config   $(brew --prefix)/var/vybench/bench/sites/
    Extra benches    $(brew --prefix)/var/vybench/benches/<name>/
    Database files   $(brew --prefix)/var/vybench/mariadb/
    Logs             $(brew --prefix)/var/log/vybench/
    MariaDB socket   $(brew --prefix)/var/run/vybench/mysql.sock
    Ports            MariaDB 13306, Redis 16379, web 8000
                     (Homebrew's own mariadb/redis on 3306/6379 are not used)

  MORE INFO

    Docs:   https://github.com/vyogotech/vybench
    Issues: https://github.com/vyogotech/vybench/issues

EOF
}

# ---------------------------------------------------------------------------
# dispatch
# ---------------------------------------------------------------------------
# vybench-tui is the interactive TUI and the multi-bench CLI. It sits next to
# this script both when installed and in a checkout that ran `make tui`, so
# that copy wins: a checkout must not pick up an older installed build.
TUI_BIN="$SCRIPT_DIR/vybench-tui"
[ -x "$TUI_BIN" ] || TUI_BIN="$HOMEBREW_PREFIX/opt/$VYBENCH_NAME/bin/vybench-tui"
[ -x "$TUI_BIN" ] || TUI_BIN="$HOMEBREW_PREFIX/bin/vybench-tui"
# The TUI runs bench commands through this wrapper so they get the same
# environment as a hand-typed one.
VYBENCH_CLI="$SCRIPT_DIR/$(basename "$SOURCE")"
export VYBENCH_CLI

if [ -z "${1:-}" ]; then
  if [ -t 0 ] && [ -t 1 ] && [ -x "$TUI_BIN" ]; then
    CMD="tui"
  else
    CMD="help"
  fi
else
  CMD="$1"
  shift || true
fi

case "$CMD" in
  # ── interactive TUI ────────────────────────────────────────────────────
  tui)
    bootstrap_common
    if [ ! -x "$TUI_BIN" ]; then
      echo "vybench: vybench-tui binary not found. Build it with 'make tui' or install via Homebrew." >&2
      exit 1
    fi
    exec "$TUI_BIN" "$@"
    ;;

  # ── diagnose and repair ───────────────────────────────────────────────
  doctor)
    if [ ! -x "$TUI_BIN" ]; then
      echo "vybench: 'doctor' needs vybench-tui, which is not installed. Build it with 'make tui'." >&2
      exit 1
    fi
    exec "$TUI_BIN" doctor "$@"
    ;;

  # ── bench commands & passthrough ──────────────────────────────────────
  bench)
    # Multi-bench commands belong to vybench-tui. These names never reach
    # frappe's bench: its own `bench drop` deletes a bench directory.
    case "${1:-}" in
      list|current|switch|new|attach|drop)
        if [ ! -x "$TUI_BIN" ]; then
          echo "vybench: 'bench $1' needs vybench-tui, which is not installed. Build it with 'make tui'." >&2
          exit 1
        fi
        exec "$TUI_BIN" bench "$@"
        ;;
      doctor)
        if [ ! -x "$TUI_BIN" ]; then
          echo "vybench: 'bench doctor' needs vybench-tui, which is not installed. Build it with 'make tui'." >&2
          exit 1
        fi
        exec "$TUI_BIN" "$@"
        ;;
    esac

    bootstrap_common
    if [ "$1" = "init" ]; then
      # If running `bench init`, inject --python $PYTHON automatically if omitted
      has_python=0
      for arg in "$@"; do
        if [ "$arg" = "--python" ]; then has_python=1; break; fi
      done
      if [ $has_python -eq 0 ]; then
        set -- "$@" --python "$PYTHON"
      fi
    elif [ ! -f "Procfile" ] && [ ! -d "sites" ]; then
      # Not in a custom bench folder -> use default vybench managed bench
      cd "$BENCH_ROOT"
    fi
    # new-site, drop-site and restore need the MariaDB root login. Inject the
    # vybench-managed credentials when the caller does not supply
    # --db-root-username, so frappe never falls back to getpass(), which
    # raises EOFError without a TTY (CI, the TUI): an empty
    # --db-root-password "" is falsy in Python and does not suppress it.
    # The subcommand may follow --site <name>, as in
    # `bench --site x restore file.sql.gz`. PostgreSQL needs its own
    # superuser, so --db-type postgres is left alone.
    _vb_args=("$@")
    _vb_at=0
    [ "${_vb_args[0]:-}" = "--site" ] && _vb_at=2
    case "${_vb_args[$_vb_at]:-}" in
      new-site|drop-site|restore)
        _vb_inject=1
        _vb_prev=""
        for _vb_arg in "$@"; do
          case "$_vb_arg" in
            --db-root-username|--db-root-username=*|--mariadb-root-username|--mariadb-root-username=*|--root-login|--db-type=postgres)
              _vb_inject=0 ;;
          esac
          [ "$_vb_prev" = "--db-type" ] && [ "$_vb_arg" = "postgres" ] && _vb_inject=0
          _vb_prev="$_vb_arg"
        done
        _vb_pw_file="$VYBENCH_VAR/mariadb/root_password"
        if [ "$_vb_inject" -eq 1 ] && [ -f "$_vb_pw_file" ]; then
          _vb_root_pw="$(cat "$_vb_pw_file")"
          _vb_next=$((_vb_at + 1))
          set -- "${_vb_args[@]:0:$_vb_next}" --db-root-username root --db-root-password "$_vb_root_pw" "${_vb_args[@]:$_vb_next}"
        fi
        ;;
    esac
    exec "$BENCH_PY" "$BENCH_CLI" "$@"
    ;;

  # ── configuration ──────────────────────────────────────────────────────
  set)
    # e.g.: vybench set mode=developer
    for pair in "$@"; do
      key="${pair%%=*}"
      val="${pair#*=}"
      vybench_config_set "$key" "$val"
      echo "vybench: $key set to '$val'"
    done

    # Apply mode change immediately
    MODE="$(get_mode)"
    CFG="$BENCH_ROOT/sites/common_site_config.json"
    if [ -f "$CFG" ]; then
      if [ "$MODE" = "developer" ]; then DEV=1; else DEV=0; fi
      "$BENCH_PY" - "$CFG" "$DEV" <<'PYEOF' 2>/dev/null || true
import json, sys
path, dev = sys.argv[1], int(sys.argv[2])
with open(path) as fh:
    cfg = json.load(fh)
cfg["developer_mode"] = dev
with open(path, "w") as fh:
    json.dump(cfg, fh, indent=2)
PYEOF
      echo "vybench: developer_mode set to $DEV in common_site_config.json"
    fi

    # Materialise bench for developer mode
    if [ "$MODE" = "developer" ]; then
      materialise_bench
    fi
    ;;

  get)
    key="${1:-mode}"
    val="$(vybench_config_get "$key")"
    [ -n "$val" ] && echo "$val" || echo "(not set — default: production)"
    ;;

  # ── service control ────────────────────────────────────────────────────
  start)
    # The vybench service starts its own MariaDB and Redis, on ports of their
    # own; Homebrew's mariadb and redis services are neither needed nor touched.
    echo "Starting $VYBENCH_NAME (MariaDB on port $VYBENCH_DB_PORT, Redis on port $VYBENCH_REDIS_PORT)..."
    brew services start "$VYBENCH_NAME"
    ;;

  stop)
    brew services stop "$VYBENCH_NAME"
    ;;

  restart)
    brew services restart "$VYBENCH_NAME"
    ;;

  status)
    brew services list | grep -E "^$VYBENCH_NAME " || echo "$VYBENCH_NAME is not a registered brew service."
    if _vb_socket_live "$MYSQL_SOCKET"; then _vb_db=running; else _vb_db=stopped; fi
    if nc -z 127.0.0.1 "$VYBENCH_REDIS_PORT" 2>/dev/null; then _vb_redis=running; else _vb_redis=stopped; fi
    echo "MariaDB (vybench, port $VYBENCH_DB_PORT): $_vb_db"
    echo "Redis   (vybench, port $VYBENCH_REDIS_PORT): $_vb_redis"
    ;;

  # ── logs ───────────────────────────────────────────────────────────────
  logs)
    svc="${1:-web}"
    logfile="$VYBENCH_LOG/${svc}.log"
    if [ -f "$logfile" ]; then
      exec tail -f "$logfile"
    else
      echo "No log file found at $logfile" >&2
      echo "Available logs in $VYBENCH_LOG:" >&2
      ls "$VYBENCH_LOG"/ 2>/dev/null || echo "(none yet)" >&2
      exit 1
    fi
    ;;

  # ── client tools ───────────────────────────────────────────────────────
  mysql)
    exec mariadb -u root --socket="$MYSQL_SOCKET" "$@"
    ;;

  mysqldump)
    exec mariadb-dump -u root --socket="$MYSQL_SOCKET" "$@"
    ;;

  redis-cli)
    exec redis-cli -p "$VYBENCH_REDIS_PORT" "$@"
    ;;

  # ── help ───────────────────────────────────────────────────────────────
  help|--help|-h)
    show_help
    ;;

  *)
    echo "vybench: unknown command '$CMD'. Run 'vybench help' for usage." >&2
    exit 1
    ;;
esac
