[Unit]
# Without this nothing scheduled ever runs: no cron jobs, no email queue flush,
# no auto-repeat, no scheduled reports. It fails silently -- the site works
# perfectly right up until someone notices no email has ever been sent.
#
# This process is only half of it. Each site ALSO needs its own scheduler
# enabled (`bench --site <site> scheduler enable`); frappista-setup does that
# when it creates a site.
Description=Frappe scheduler
Documentation=https://github.com/vyogotech/frappista
After=network-online.target @MARIADB_SVC@ @REDIS_SVC@
Wants=network-online.target
Requires=@MARIADB_SVC@ @REDIS_SVC@
PartOf=frappista.target

[Service]
Type=simple
User=frappe
Group=frappe

Environment=HOME=@BENCH@
EnvironmentFile=-/etc/frappista/frappista.env

WorkingDirectory=@BENCH@
ExecStart=@BENCH@/env/bin/bench schedule

Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=@BENCH@

StandardOutput=journal
StandardError=journal
SyslogIdentifier=frappe-scheduler

[Install]
WantedBy=multi-user.target
