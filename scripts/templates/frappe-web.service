[Unit]
Description=Frappe web server (gunicorn)
Documentation=https://github.com/vyogotech/frappista
After=network-online.target @MARIADB_SVC@ @REDIS_SVC@
Wants=network-online.target
Requires=@MARIADB_SVC@ @REDIS_SVC@
PartOf=frappista.target

[Service]
Type=simple
User=frappe
Group=frappe

# Defaults first, then the operator's overrides -- systemd applies these in the
# order they appear, so the EnvironmentFile wins. The `-` prefix makes the file
# optional, which is why every variable also needs a default here: an unset
# variable expands to nothing and would silently mangle the command line.
Environment=HOME=@BENCH@
Environment=FRAPPE_WEB_BIND=127.0.0.1:8000
Environment=FRAPPE_WEB_WORKERS=4
Environment=FRAPPE_WEB_THREADS=4
Environment=FRAPPE_WEB_TIMEOUT=120
EnvironmentFile=-/etc/frappista/frappista.env

# gunicorn must run from sites/, which is how frappe locates
# common_site_config.json and the per-site directories.
WorkingDirectory=@BENCH@/sites

# frappe.app:application serves NO static files. That is correct here and only
# here: unlike the snap, a native install has a real nginx in front (see
# frappista-setup), which serves /assets and /files straight off disk. If you
# disable nginx you must put something else in front, or every asset 404s.
ExecStart=@BENCH@/env/bin/gunicorn \
    --bind ${FRAPPE_WEB_BIND} \
    --workers ${FRAPPE_WEB_WORKERS} \
    --threads ${FRAPPE_WEB_THREADS} \
    --worker-class gthread \
    --timeout ${FRAPPE_WEB_TIMEOUT} \
    --preload \
    frappe.app:application

Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=@BENCH@

StandardOutput=journal
StandardError=journal
SyslogIdentifier=frappe-web

[Install]
WantedBy=multi-user.target
