#!/bin/bash
set -e

. "$SNAP/bin/snap-common.sh"

bootstrap_datastores

# Everything below this line runs as snap_daemon, so both mariadb-install-db and
# mariadbd create their files unprivileged. --user= is deliberately NOT passed:
# mariadbd only accepts that switch when started as root, and we no longer are.
reexec_as_daemon "$0" "$@"

DATA_DIR="$SNAP_COMMON/mariadb"
SOCKET="$SNAP_COMMON/run/mysql.sock"
PID_FILE="$SNAP_COMMON/mariadb/mariadb.pid"

mkdir -p "$DATA_DIR"

if [ ! -d "$DATA_DIR/mysql" ]; then
  echo "Initializing MariaDB system database in $DATA_DIR..."
  "$SNAP/usr/bin/mariadb-install-db" \
    --basedir="$SNAP/usr" \
    --datadir="$DATA_DIR" \
    --auth-root-authentication-method=normal \
    --skip-test-db

  # mariadb-install-db leaves root with an EMPTY password. That is bad twice
  # over: any local user could connect as root, and `bench new-site` would block
  # forever because frappe treats a falsy root_password as "prompt interactively"
  # (raising EOFError under systemd). Provision a random password now, on a
  # private socket with networking disabled, before the real server opens up.
  ROOT_PW=$(head -c 24 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 20)
  INIT_SOCK="$DATA_DIR/init.sock"

  "$SNAP/usr/sbin/mariadbd" \
    --basedir="$SNAP/usr" \
    --datadir="$DATA_DIR" \
    --socket="$INIT_SOCK" \
    --pid-file="$DATA_DIR/init.pid" \
    --skip-networking &
  INIT_PID=$!

  for _ in $(seq 1 60); do
    [ -S "$INIT_SOCK" ] && break
    sleep 1
  done

  "$SNAP/usr/bin/mariadb" -u root -S "$INIT_SOCK" -e "
    ALTER USER 'root'@'localhost' IDENTIFIED BY '$ROOT_PW';
    ALTER USER 'root'@'127.0.0.1' IDENTIFIED BY '$ROOT_PW';
    FLUSH PRIVILEGES;"

  "$SNAP/usr/bin/mariadb-admin" -u root -p"$ROOT_PW" -S "$INIT_SOCK" shutdown
  wait "$INIT_PID" 2>/dev/null || true
  rm -f "$INIT_SOCK" "$DATA_DIR/init.pid"

  # Record it for the operator, and hand it to bench so `new-site` is
  # non-interactive. NOTE: common_site_config.json is world-readable, so this
  # password is not a secret from local users -- it is a large improvement on
  # the empty password it replaces, not a hardening boundary.
  echo "$ROOT_PW" > "$DATA_DIR/root_password"
  "$SNAP/opt/frappe-bench/env/bin/python3.14" - \
    "$SNAP_COMMON/bench/sites/common_site_config.json" "$ROOT_PW" <<'PYEOF'
import json, sys
path, pw = sys.argv[1], sys.argv[2]
with open(path) as fh:
    cfg = json.load(fh)
cfg["root_password"] = pw
with open(path, "w") as fh:
    json.dump(cfg, fh, indent=1)
PYEOF
  echo "MariaDB root password provisioned; stored in $DATA_DIR/root_password"
fi

# The datadir holds the database files and stays private. The socket now lives in
# $SNAP_COMMON/run (0755), so clients do not need access to this directory at all.
chmod u+rwx,g+rwx,o-rwx "$DATA_DIR" 2>/dev/null || true

exec "$SNAP/usr/sbin/mariadbd" \
  --basedir="$SNAP/usr" \
  --datadir="$DATA_DIR" \
  --socket="$SOCKET" \
  --pid-file="$PID_FILE" \
  --port=3306 \
  --bind-address=127.0.0.1 \
  --character-set-server=utf8mb4 \
  --collation-server=utf8mb4_unicode_ci \
  --max-allowed-packet=256M \
  --innodb-file-per-table=1
