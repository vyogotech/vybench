#!/bin/bash
set -e

. "$SNAP/bin/snap-common.sh"

# Queue name comes from the app definition (bin/worker-wrapper <queue>).
QUEUE="${1:-default}"

bootstrap_common
# The active bench, resolved by snap-common.sh (current-bench, else the legacy one).
BENCH_DIR="$LIVE_BENCH"

# Runs as snap_daemon, so bench's is_root() is false and change_uid() -- which
# would try to setuid to a `frappe` user that does not exist on the host -- is
# never reached. Enter the bench AFTER setpriv (see run_as_daemon_in).
run_as_daemon_in "$BENCH_DIR" "$BENCH_PY" \
  "$BENCH_CLI" worker --queue "$QUEUE"
