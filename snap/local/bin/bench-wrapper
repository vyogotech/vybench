#!/bin/bash
set -e

. "$SNAP/bin/snap-common.sh"

# vybench-tui is the interactive TUI and the multi-bench CLI (tui part).
TUI_BIN="$SNAP/bin/vybench-tui"
if [ -x "$TUI_BIN" ]; then
  # Bare in a terminal, or `tui`: the interactive TUI.
  if [ $# -eq 0 ] && [ -t 0 ] && [ -t 1 ]; then
    exec "$TUI_BIN"
  fi
  if [ "${1:-}" = "tui" ]; then
    shift
    exec "$TUI_BIN" "$@"
  fi
  # Multi-bench commands, as `vybench.bench bench list` or `vybench.bench list`.
  # These names never reach frappe's bench: its own `bench drop` deletes a
  # bench directory.
  if [ "${1:-}" = "bench" ]; then
    case "${2:-}" in list|current|switch|new|attach|drop|doctor) shift ;; esac
  fi
  case "${1:-}" in
    list|current|switch|new|attach|drop) exec "$TUI_BIN" bench "$@" ;;
    doctor) exec "$TUI_BIN" "$@" ;;
  esac
fi

# Show vybench help (trademark + quick reference) when invoked bare or with "help".
if [ $# -eq 0 ] || [ "$1" = "help" ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
  . "$SNAP/bin/show-help"
  # If bare invocation, stop here. If --help/-h, also show bench's own help.
  [ $# -eq 0 ] || [ "$1" = "help" ] && exit 0
fi

require_bench_access "$@" || exit 1

bootstrap_common

# Run against LIVE_BENCH, always -- not only when the current directory does not
# look like a bench. snap-common.sh already resolves LIVE_BENCH to the current
# directory when that directory IS a bench, so this is a no-op in the ordinary
# case; what it fixes is the case where it is not.
#
# Enter the bench AFTER dropping to snap_daemon (run_as_daemon_in). Two reasons:
# 1. A command started somewhere snap_daemon cannot enter -- /root is mode 0700
#    -- reaches bench with a cwd it cannot stat. is_bench_directory() fails and
#    the user sees "No such command 'new-site'".
# 2. Root inside a strict snap cannot itself cd into a snap_daemon-owned 0770
#    bench (no DAC override). sudo vybench.bench would fail the same way the
#    worker services did before run_as_daemon_in.
#
# `bench init` is the exception: it creates a bench at the path it is given and
# must not run from inside another one.
if [ "${1:-}" = "init" ]; then
  run_as_daemon "$BENCH_PY" "$BENCH_CLI" "$@"
fi

# Normally this already runs as the invoking host user and run_as_daemon_in is a
# plain cd+exec. It only drops privileges when someone runs `sudo vybench.bench`,
# which bench would otherwise refuse to do.
run_as_daemon_in "$LIVE_BENCH" "$BENCH_PY" \
  "$BENCH_CLI" "$@"
