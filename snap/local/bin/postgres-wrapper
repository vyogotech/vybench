#!/bin/bash
set -e

. "$SNAP/bin/snap-common.sh"

bootstrap_datastores

# Everything below this line runs as snap_daemon
reexec_as_daemon "$0" "$@"

DATA_DIR="$SNAP_COMMON/postgres"
SOCKET_DIR="$SNAP_COMMON/run"

mkdir -p "$DATA_DIR" "$SOCKET_DIR"

INITDB_BIN=$(find /usr/lib/postgresql -name initdb 2>/dev/null | head -1 || find "$SNAP/usr/lib/postgresql" -name initdb 2>/dev/null | head -1)
POSTGRES_BIN=$(find /usr/lib/postgresql -name postgres 2>/dev/null | head -1 || find "$SNAP/usr/lib/postgresql" -name postgres 2>/dev/null | head -1)
PSQL_BIN=$(find /usr/lib/postgresql -name psql 2>/dev/null | head -1 || find "$SNAP/usr/lib/postgresql" -name psql 2>/dev/null | head -1)
PG_ISREADY_BIN=$(find /usr/lib/postgresql -name pg_isready 2>/dev/null | head -1 || find "$SNAP/usr/lib/postgresql" -name pg_isready 2>/dev/null | head -1)
PG_SHARE_DIR=$(find /usr/share/postgresql "$SNAP/usr/share/postgresql" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | head -1)
export PGSHAREDIR="$PG_SHARE_DIR"

if [ ! -f "$DATA_DIR/PG_VERSION" ]; then
  echo "Initializing PostgreSQL system database in $DATA_DIR..."
  "$INITDB_BIN" -D "$DATA_DIR" -L "$PG_SHARE_DIR" --username=postgres --auth=trust

  ROOT_PW=$(head -c 24 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 20)

  "$POSTGRES_BIN" -D "$DATA_DIR" -k "$SOCKET_DIR" -h "" -p 5432 &
  INIT_PID=$!

  for _ in $(seq 1 60); do
    if "$PG_ISREADY_BIN" -h "$SOCKET_DIR" -p 5432 >/dev/null 2>&1; then
      break
    fi
    sleep 1
  done

  "$PSQL_BIN" -h "$SOCKET_DIR" -p 5432 -U postgres -d postgres -c "
    ALTER USER postgres WITH PASSWORD '$ROOT_PW';
    CREATE ROLE frappe WITH LOGIN SUPERUSER PASSWORD '$ROOT_PW';
    ALTER ROLE frappe WITH PASSWORD '$ROOT_PW';
  " || true

  kill -15 "$INIT_PID" 2>/dev/null || true
  wait "$INIT_PID" 2>/dev/null || true

  echo "$ROOT_PW" > "$DATA_DIR/root_password"

  # Ensure the bench sites directory and config exist before writing root_password.
  # bootstrap_common (called by web/worker wrappers) normally seeds this file, but
  # there is no guaranteed service start order -- postgres may initialise before any
  # other service runs bootstrap_common, so we seed it here if absent.
  CFG="$SNAP_COMMON/bench/sites/common_site_config.json"
  if [ ! -f "$CFG" ]; then
    mkdir -p "$(dirname "$CFG")"
    cp "$SNAP/config/common_site_config.json" "$CFG" 2>/dev/null || true
    "$BENCH_PY" - "$CFG" <<'PYEOF' || true
import json, sys
path = sys.argv[1]
with open(path) as fh:
    cfg = json.load(fh)
cfg["db_type"] = "postgres"
cfg["db_port"] = 5432
cfg["db_host"] = "127.0.0.1"
cfg.pop("db_socket", None)
with open(path, "w") as fh:
    json.dump(cfg, fh, indent=1)
PYEOF
  fi

  "$BENCH_PY" - "$CFG" "$ROOT_PW" <<'PYEOF'
import json, sys
path, pw = sys.argv[1], sys.argv[2]
with open(path) as fh:
    cfg = json.load(fh)
cfg["root_password"] = pw
with open(path, "w") as fh:
    json.dump(cfg, fh, indent=1)
PYEOF
  echo "PostgreSQL root password provisioned; stored in $DATA_DIR/root_password"
fi

chmod 700 "$DATA_DIR" 2>/dev/null || true
chmod -R 700 "$DATA_DIR" 2>/dev/null || true

exec "$POSTGRES_BIN" -D "$DATA_DIR" -k "$SOCKET_DIR" -h "127.0.0.1" -p 5432
